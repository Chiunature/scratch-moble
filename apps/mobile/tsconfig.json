{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@scratch-mobile/core": ["../../packages/core/src"],
      "@scratch-mobile/protocol": ["../../packages/protocol/src"],
      "@scratch-mobile/shared": ["../../packages/shared/src"],
      "@scratch-mobile/i18n": ["../../packages/i18n/src"],
      "@scratch-mobile/build-guide": ["../../packages/build-guide/src"],
      "@scratch-mobile/ldr-engine": ["../../packages/ldr-engine/src"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
