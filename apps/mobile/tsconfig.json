{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": "../..",
    "composite": false,
    "noEmit": true,
    "paths": {
      "@scratch-mobile/core": ["packages/core/src"],
      "@scratch-mobile/protocol": ["packages/protocol/src"],
      "@scratch-mobile/shared": ["packages/shared/src"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
